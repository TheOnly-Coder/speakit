{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "outDir": ".server",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "jsx": "react",
    "plugins": []
  },
  "include": ["server.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules"]
}
