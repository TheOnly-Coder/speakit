{
  "name": "speakit",
  "version": "1.0.0",
  "private": true,
  "description": "Speakit — a Discord-like real-time chat & voice app",
  "scripts": {
    "dev": "npm run build:server && node -r ./server-preload.cjs .server/server.js",
    "build": "prisma generate && npm run build:server && next build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node -r ./server-preload.cjs .server/server.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "2.1.1",
    "lucide-react": "0.438.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.7.5",
    "socket.io-client": "4.7.5",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "20.16.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.41",
    "prisma": "5.18.0",
    "tailwindcss": "3.4.10",
    "tsx": "4.16.5",
    "typescript": "5.5.4"
  }
}
